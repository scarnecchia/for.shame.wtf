{
  "name": "for.shame.wtf",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "npx tsx src/main.ts",
    "dev": "npx tsx --watch src/main.ts",
    "negate": "npx tsx src/negate.ts",
    "format": "bunx prettier --write .",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint --fix .",
    "set-posts": "bunx tsx src/set-posts.ts",
    "set-labels": "bunx tsx src/set-labels.ts",
    "set-db": "bunx tsx src/setup-db.ts",
    "backfill-db": "bunx tsx src/backfill/setup-db.ts",
    "backfill": "bunx tsx src/backfill/main.ts",
    "unlabel-all": "bunx tsx src/unlabel-all.ts",
    "prepare": "bunx husky install"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  },
  "dependencies": {
    "@atproto/api": "^0.15.14",
    "@skyware/bot": "^0.3.11",
    "@skyware/jetstream": "^0.2.2",
    "@skyware/labeler": "^0.2.0",
    "@solidjs/router": "^0.15.3",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "p-ratelimit": "^1.0.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "undici": "^7.10.0"
  }
}